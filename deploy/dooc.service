[Unit]
Description=Dooc documentation and collaboration
After=network.target

[Service]
Type=simple
User=dooc
Group=dooc
WorkingDirectory=/opt/dooc/current
Environment=NODE_ENV=production
Environment=HOST=192.168.3.23
Environment=PORT=8788
Environment=DOOC_REPO=/srv/data/dooc/repo
Environment=DOOC_DB=/srv/data/dooc/collab.db
ExecStart=/usr/bin/node /opt/dooc/current/deploy/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/data/dooc
UMask=0027

[Install]
WantedBy=multi-user.target
